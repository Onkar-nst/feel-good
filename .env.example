# Razorpay. Get these from Dashboard → Settings → API Keys.
# Start with rzp_test_ keys; swap for rzp_live_ keys after KYC.
NUXT_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
NUXT_RAZORPAY_KEY_SECRET=your_secret_here
# Same key id again, exposed to the browser (key ids are safe to publish; the secret is not).
NUXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# Dashboard → Settings → Webhooks → add https://<your-domain>/api/razorpay/webhook, event payment.captured, any secret you choose.
NUXT_RAZORPAY_WEBHOOK_SECRET=

# Gmail used to send form responses and booking notices.
# Use a Gmail App Password (Google Account → Security → 2-Step Verification → App passwords).
NUXT_GMAIL_USER=you@gmail.com
NUXT_GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Where notifications land. Leave blank to use NUXT_GMAIL_USER.
NUXT_NOTIFY_EMAIL=

# Google Calendar Direct Sync (OAuth 2.0 with Refresh Token)
# Create in Google Cloud Console -> Credentials -> OAuth 2.0 Client ID (Web application)
# Enable Google Calendar API in Google Cloud Console.
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_GOOGLE_REFRESH_TOKEN=
NUXT_GOOGLE_CALENDAR_ID=primary
